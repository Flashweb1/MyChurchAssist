# Auto detect text files and normalize line endings to LF
* text=auto

# Explicitly set line endings for common file types
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.rules text eol=lf
*.toml text eol=lf

# Binary files should not have line ending conversion
*.png binary
*.jpg binary
*.gif binary
*.ttf binary
*.otf binary
