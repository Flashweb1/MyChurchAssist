rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userChurchId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId 
        : request.auth.uid;
    }

    function isSameChurch(resourceData) {
      return isAuthenticated() && resourceData.churchId == userChurchId();
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == "super_admin" || 
        request.auth.token.role == "admin"
      );
    }

    // Church settings (isolated by churchId)
    match /settings/{document} {
      allow read, write: if isAuthenticated() && document == userChurchId();
    }

    // Users
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || resource.data.churchId == userChurchId());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        (resource.data.churchId == userChurchId() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "super_admin") ||
        (request.auth.uid == userId && 
         (!("role" in resource.data) || request.resource.data.role == resource.data.role) && 
         (!("churchId" in resource.data) || request.resource.data.churchId == resource.data.churchId) &&
         (!("email" in resource.data) || request.resource.data.email == resource.data.email))
      );
      allow delete: if isAuthenticated() && resource.data.churchId == userChurchId() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "super_admin";
    }

    // Invitations
    match /invitations/{inviteId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.churchId == userChurchId() || request.auth.token.email == resource.data.email);
      allow create: if isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "super_admin";
      allow update: if isAuthenticated() && (resource.data.churchId == userChurchId() || request.auth.token.email == resource.data.email);
      allow delete: if isAuthenticated() && resource.data.churchId == userChurchId();
    }

    // Members (with soft delete support)
    match /members/{docId} {
      // Admins can view all including archived; regular users only see non-deleted
      allow read: if isSameChurch(resource.data) && (isAdmin() || resource.data.deletedAt == null);
      allow create: if isSameChurch(request.resource.data);
      allow update: if isSameChurch(resource.data) && isSameChurch(request.resource.data);
      allow delete: if isSameChurch(resource.data);
    }

    // Newcomers (with soft delete support)
    match /newcomers/{docId} {
      allow read: if isSameChurch(resource.data) && (isAdmin() || resource.data.deletedAt == null);
      allow create: if isSameChurch(request.resource.data);
      allow update: if isSameChurch(resource.data) && isSameChurch(request.resource.data);
      allow delete: if isSameChurch(resource.data);
    }

    // Attendance - no soft delete
    match /attendance/{docId} {
      allow read: if isSameChurch(resource.data);
      allow create: if isSameChurch(request.resource.data);
      allow update: if isSameChurch(resource.data) && isSameChurch(request.resource.data);
      allow delete: if isSameChurch(resource.data);
    }

    // Departments (with soft delete support)
    match /departments/{docId} {
      allow read: if isSameChurch(resource.data) && (isAdmin() || resource.data.deletedAt == null);
      allow create: if isSameChurch(request.resource.data);
      allow update: if isSameChurch(resource.data) && isSameChurch(request.resource.data);
      allow delete: if isSameChurch(resource.data);
    }

    // Transactions (with soft delete support)
    match /transactions/{txId} {
      allow read: if isSameChurch(resource.data) && (isAdmin() || resource.data.deletedAt == null);
      allow create: if isSameChurch(request.resource.data);
      allow update: if isSameChurch(resource.data) && isSameChurch(request.resource.data);
      allow delete: if isSameChurch(resource.data);
    }

    // Follow-ups (with soft delete support)
    match /followups/{taskId} {
      allow read: if isSameChurch(resource.data) && (isAdmin() || resource.data.deletedAt == null);
      allow create: if isSameChurch(request.resource.data);
      allow update: if isSameChurch(resource.data) && isSameChurch(request.resource.data);
      allow delete: if isSameChurch(resource.data);
    }

    // Messages (with soft delete support)
    match /messages/{msgId} {
      allow read: if isSameChurch(resource.data) && (isAdmin() || resource.data.deletedAt == null);
      allow create: if isSameChurch(request.resource.data);
      allow update: if isSameChurch(resource.data) && isSameChurch(request.resource.data);
      allow delete: if isSameChurch(resource.data);
    }

    // Wallets
    match /wallets/{docId} {
      allow read: if isSameChurch(resource.data);
      allow create: if isSameChurch(request.resource.data);
      allow update: if isSameChurch(resource.data) && isSameChurch(request.resource.data);
      allow delete: if isSameChurch(resource.data);
    }

    match /wallet_transactions/{txId} {
      allow read: if isSameChurch(resource.data);
      allow create: if isSameChurch(request.resource.data);
      allow update: if isSameChurch(resource.data) && isSameChurch(request.resource.data);
      allow delete: if isSameChurch(resource.data);
    }

    match /message_deliveries/{deliveryId} {
      allow read: if isSameChurch(resource.data);
      allow create: if isSameChurch(request.resource.data);
      allow update: if isSameChurch(resource.data) && isSameChurch(request.resource.data);
    }

    // Audit logs (admins only)
    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && resource.data.churchId == userChurchId() && isAdmin();
      allow create: if isAuthenticated();
    }

    // Birthday config (isolated by churchId)
    match /birthday_config/{docId} {
      allow read, write: if isAuthenticated() && docId == userChurchId();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}